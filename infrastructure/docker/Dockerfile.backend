# Build stage
FROM golang:1.26.8-alpine@sha256:8ac98ca534ac3f51e1f420a1dd2c15e74c75cfa0f23f3ad27eb5d7236c349a0c AS builder

# Install build dependencies
RUN apk add --no-cache git ca-certificates

# Set working directory
WORKDIR /app

# Copy go mod files
COPY apps/backend/go.mod apps/backend/go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY apps/backend/ ./

# Build the application for the target platform.
# GET /health/ready reports main.buildCommit as `commit` and main.buildVersion
# as `version`. COMMIT is the full 40-character sha of the commit the image is
# built from; a build that passes none reports "commit": null.
ARG TARGETARCH
ARG VERSION=dev
ARG COMMIT
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build \
    -ldflags="-s -w -X main.buildVersion=${VERSION} -X main.buildCommit=${COMMIT}" \
    -o /bin/aim-server ./cmd/server

# Build the migrate and bootstrap binaries so operators can run them inside the
# container (`docker compose run --rm aim-backend /app/aim-migrate` then
# `aim-bootstrap --default`). Bootstrap is the post-B2 seed path for the default
# admin user; migration 013 only seeds the org now.
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build \
    -ldflags="-s -w" \
    -o /bin/aim-migrate ./cmd/migrate
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build \
    -ldflags="-s -w" \
    -o /bin/aim-bootstrap ./cmd/bootstrap

# Third-party license notices. Every library linked into the three binaries is
# redistributed in this image, so the image carries each one's license text, a
# pointer to its source and, for the MPL-2.0 libraries, the source itself. The
# script installs go-licenses at this pin, writes /third_party and verifies it;
# any failure fails the build. The pin must equal the one
# .github/workflows/security.yml gives the license gate.
ARG GO_LICENSES_VERSION=v2.0.1
ARG GO_LICENSES_SUM=h1:ti+9bi5o7DKbeeg5eBb/uZTgsaPNoJaLCh93cRcXsW8=
RUN CGO_ENABLED=0 sh scripts/third-party-notices.sh /third_party

# Runtime stage
FROM alpine:3.21@sha256:ce64758a109eb420d874a118f87920e625e12d3634e03b4a5573fd9f6e5d3507

RUN apk --no-cache add ca-certificates

# SECURITY: Run as non-root user
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

WORKDIR /app

# Copy the binaries from builder
COPY --from=builder /bin/aim-server /bin/aim-migrate /bin/aim-bootstrap ./

# Copy migrations
COPY apps/backend/migrations ./migrations

# Copy SDK directory
COPY sdk ./sdk

# Third-party license notices: /app/third_party/README says what is there
COPY --from=builder /third_party ./third_party

# Ensure correct ownership
RUN chown -R appuser:appgroup /app

USER appuser

# OCI labels
LABEL org.opencontainers.image.source="https://github.com/opena2a-org/agent-identity-management"
LABEL org.opencontainers.image.title="AIM Server"
LABEL org.opencontainers.image.description="Open-source non-human identity platform for AI agents — cryptographic identity, governance, and access control"
LABEL org.opencontainers.image.licenses="Apache-2.0"

# Expose port
EXPOSE 8080

# Run the application
CMD ["./aim-server"]

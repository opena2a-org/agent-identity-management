# Build stage
FROM golang:1.25-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git ca-certificates

# Set working directory
WORKDIR /app

# Copy go mod files
COPY apps/backend/go.mod apps/backend/go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY apps/backend/ ./

# Build the application for the target platform
ARG TARGETARCH
ARG VERSION=dev
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build \
    -ldflags="-s -w -X main.version=${VERSION}" \
    -o /bin/aim-server ./cmd/server

# Runtime stage
FROM alpine:3.21

RUN apk --no-cache add ca-certificates

# SECURITY: Run as non-root user
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

WORKDIR /app

# Copy the binary from builder
COPY --from=builder /bin/aim-server .

# Copy migrations
COPY apps/backend/migrations ./migrations

# Copy SDK directory
COPY sdk ./sdk

# Ensure correct ownership
RUN chown -R appuser:appgroup /app

USER appuser

# OCI labels
LABEL org.opencontainers.image.source="https://github.com/opena2a-org/agent-identity-management"
LABEL org.opencontainers.image.title="AIM Server"
LABEL org.opencontainers.image.description="Open-source non-human identity platform for AI agents — cryptographic identity, governance, and access control"
LABEL org.opencontainers.image.licenses="Apache-2.0"

# Expose port
EXPOSE 8080

# Run the application
CMD ["./aim-server"]

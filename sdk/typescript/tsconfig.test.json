// Type-checks the test files that tsconfig.json leaves out (`npm run typecheck`
// runs both). tests/typecheck-covers-tests.test.ts pins that it reads every
// test file.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}

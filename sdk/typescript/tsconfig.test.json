// Type-checks the test files that tsconfig.json leaves out (`npm run typecheck`
// runs both). The two integration files below are left out until they are
// rewritten against the current client: they call methods A2AClient does not
// have (publishAgentCard, updatePeerTrust), and loadCredentialsFromFile, which
// one never imports and the other calls without its path argument.
// tests/typecheck-covers-tests.test.ts pins this list.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*", "tests/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "src/a2a/A2AClient.integration.test.ts",
    "src/client/AIMClient.integration.test.ts"
  ]
}

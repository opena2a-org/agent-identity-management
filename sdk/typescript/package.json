{
  "name": "@opena2a/aim-sdk",
  "version": "1.0.2",
  "description": "Agent Identity Management SDK for TypeScript/Node.js",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./arp": {
      "types": "./dist/arp/index.d.ts",
      "import": "./dist/arp/index.mjs",
      "require": "./dist/arp/index.js"
    },
    "./express": {
      "types": "./dist/integrations/express.d.ts",
      "import": "./dist/integrations/express.mjs",
      "require": "./dist/integrations/express.js"
    },
    "./fastify": {
      "types": "./dist/integrations/fastify.d.ts",
      "import": "./dist/integrations/fastify.mjs",
      "require": "./dist/integrations/fastify.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "arp",
    "express",
    "fastify",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:harness": "vitest run --config vitest.harness.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "smoke:local": "npm run build && node tests/local-verify-consumer.cjs && node tests/local-verify-consumer.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "aim",
    "agent",
    "identity",
    "management",
    "ai",
    "llm",
    "security",
    "authentication",
    "verification"
  ],
  "author": "OpenA2A",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/opena2a-org/agent-identity-management.git",
    "directory": "sdk/typescript"
  },
  "bugs": {
    "url": "https://github.com/opena2a-org/agent-identity-management/issues"
  },
  "homepage": "https://github.com/opena2a-org/agent-identity-management#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@noble/ed25519": "^2.1.0",
    "@noble/post-quantum": "^0.2.1",
    "@opena2a/atx-verify": "0.3.0",
    "fastify-plugin": "^6.0.0",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "fastify": "^5.6.2",
    "fastify4": "npm:fastify@^4.29.1",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0",
    "fastify": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    }
  }
}

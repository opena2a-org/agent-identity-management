# =============================================================================
# AIM - Minimal Configuration
# =============================================================================
# Copy to .env and run: docker compose up -d
#
# For advanced configuration, see: docs/DEPLOYMENT.md
# =============================================================================

# ----- REQUIRED: Generate these secrets -----
# Run: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32

# Run: openssl rand -base64 32
KEYVAULT_MASTER_KEY=CHANGE_ME_run_openssl_rand_base64_32

# ----- Server signing keys (optional; recommended in production) -----
# One Ed25519 seed per purpose. Unset, each key is derived from KEYVAULT_MASTER_KEY.
# Use a different value for each. Run: openssl rand -base64 32
# See docs/DEPLOYMENT.md "Server Signing Keys".
# AIM_SIGNING_KEY_CARD_ATTESTATION=
# AIM_SIGNING_KEY_ATC_ISSUER=

# ----- Database -----
POSTGRES_PASSWORD=your_secure_password_here

# ----- Email (optional, defaults to console logging) -----
# EMAIL_PROVIDER=console

# ----- Host ports and container names (optional, shown at their defaults) -----
# Change them to run the dev stack beside a quick-start, another checkout or any
# other service on the same ports. Compose names the volumes and network after
# its project (COMPOSE_PROJECT_NAME, or this directory's name), so a second
# stack also needs its own project.
# AIM_PROJECT=aim
# AIM_POSTGRES_PORT=5432
# AIM_REDIS_PORT=6379
# AIM_BACKEND_PORT=8080
# AIM_FRONTEND_PORT=3000
# AIM_ELASTICSEARCH_PORT=9200
# AIM_ELASTICSEARCH_TRANSPORT_PORT=9300
# AIM_MINIO_PORT=9000
# AIM_MINIO_CONSOLE_PORT=9001
# AIM_NATS_PORT=4222
# AIM_NATS_MONITOR_PORT=8222
# AIM_PROMETHEUS_PORT=9090
# AIM_GRAFANA_PORT=3003
# AIM_LOKI_PORT=3100

# =============================================================================
# AIM Backend Configuration - EXAMPLE FILE
# =============================================================================
# SECURITY WARNING: Copy this to .env and fill in actual values
# NEVER commit .env to version control - it contains secrets
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_db_user
# REQUIRED: Set a strong password
POSTGRES_PASSWORD=
POSTGRES_DB=identity
POSTGRES_SSL_MODE=disable                   # Use 'require' in production

# -----------------------------------------------------------------------------
# JWT Configuration
# -----------------------------------------------------------------------------
# SECURITY: Generate with: openssl rand -base64 32
# REQUIRED: Minimum 32 characters
JWT_SECRET=
JWT_ACCESS_TTL=2h                           # Access token lifetime
JWT_REFRESH_TTL=168h                        # A refresh token unused this long expires; each refresh issues a new one
JWT_SESSION_MAX_AGE=8h                      # Longest a sign-in lasts, however often it is refreshed

# -----------------------------------------------------------------------------
# Email Configuration (SMTP)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME="Agent Identity Management"
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
# Your SMTP username
SMTP_USERNAME=
# REQUIRED: Your SMTP password (use app password for Gmail)
SMTP_PASSWORD=

# -----------------------------------------------------------------------------
# Application URLs
# -----------------------------------------------------------------------------
# FRONTEND_URL's host is also the provider identifier /.well-known/aip serves (did:web:<host>)
FRONTEND_URL=http://localhost:3000          # Frontend URL for CORS, redirects and the CLI device-login page
SUPPORT_EMAIL=support@yourdomain.com

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=8080
ENVIRONMENT=development                     # development | staging | production

# -----------------------------------------------------------------------------
# Observability / Metrics
# -----------------------------------------------------------------------------
# GET /metrics is served on its own listener, not on the API port, and the
# dashboard does not proxy it.
# METRICS_LISTEN_ADDR=127.0.0.1:9464         # host:port of the metrics listener.
                                             # A loopback IP literal serves
                                             # without a token. Any other address
                                             # (0.0.0.0:9464, :9464, localhost)
                                             # refuses to start unless
                                             # METRICS_AUTH_TOKEN is set.
# METRICS_AUTH_TOKEN=                        # 32 characters or more; generate
                                             # with: openssl rand -hex 32
                                             # When set, both the metrics
                                             # listener and the API port serve
                                             # GET /metrics and require
                                             #   Authorization: Bearer <token>
                                             # A shorter value is treated as
                                             # unset and logged as an error.
                                             # Prometheus: authorization with
                                             # type Bearer and credentials_file.

# -----------------------------------------------------------------------------
# Security Settings (Production)
# -----------------------------------------------------------------------------
# AIM_PUBLIC_URL=https://your-domain.com    # Public URL for SDK downloads
# AIM_PLATFORM_ADMINS=you@example.com       # Comma-separated emails approved
                                             # automatically at signup; each becomes
                                             # admin of their own organization and can
                                             # approve other accounts in the admin
                                             # area. Empty (default): every new
                                             # account waits for an existing admin.
# CORS_ORIGINS=https://your-frontend.com    # Comma-separated allowed origins

# -----------------------------------------------------------------------------
# Key Vault Configuration (master key required outside development and test)
# -----------------------------------------------------------------------------
# KEYVAULT_MASTER_KEY=                      # openssl rand -base64 32. Required unless ENVIRONMENT
#                                          # is development or test, where a key is generated
#                                          # at every start (stored agent keys do not survive)
# KEYVAULT_STORAGE_PATH=/secure/path        # Path to encrypted key storage

# -----------------------------------------------------------------------------
# Optional: Server Signing Keys (recommended in production)
# -----------------------------------------------------------------------------
# One base64 32-byte Ed25519 seed per purpose (openssl rand -base64 32), each a
# different value. Unset, the key is derived from KEYVAULT_MASTER_KEY.
# <VAR>_RETIRED lists old public keys that still verify after a rotation.
# AIM_SIGNING_KEY_CARD_ATTESTATION=
# AIM_SIGNING_KEY_ATC_ISSUER=
# AIM_SIGNING_KEY_CARD_ATTESTATION_RETIRED=

# =============================================================================
# AIM Backend Configuration - EXAMPLE FILE
# =============================================================================
# SECURITY WARNING: Copy this to .env and fill in actual values
# NEVER commit .env to version control - it contains secrets
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=                          # REQUIRED: Set a strong password
POSTGRES_DB=identity
POSTGRES_SSL_MODE=disable                   # Use 'require' in production

# -----------------------------------------------------------------------------
# JWT Configuration
# -----------------------------------------------------------------------------
# SECURITY: Generate with: openssl rand -base64 32
JWT_SECRET=                                 # REQUIRED: Minimum 32 characters
JWT_EXPIRY=24h

# -----------------------------------------------------------------------------
# Email Configuration (SMTP)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME="Agent Identity Management"
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USERNAME=                              # Your SMTP username
SMTP_PASSWORD=                              # REQUIRED: Your SMTP password (use app password for Gmail)

# -----------------------------------------------------------------------------
# Application URLs
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000          # Frontend URL for CORS and redirects
SUPPORT_EMAIL=support@yourdomain.com

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=8080
ENVIRONMENT=development                     # development | staging | production

# -----------------------------------------------------------------------------
# Observability / Metrics
# -----------------------------------------------------------------------------
# METRICS_AUTH_TOKEN=                        # If set, GET /metrics requires
                                             #   Authorization: Bearer <token>
                                             # Leave unset to keep /metrics open
                                             # (a startup warning is logged).
                                             # Prometheus: set bearer_token /
                                             # authorization in scrape_configs.

# -----------------------------------------------------------------------------
# Security Settings (Production)
# -----------------------------------------------------------------------------
# AIM_PUBLIC_URL=https://your-domain.com    # Public URL for SDK downloads
# CORS_ORIGINS=https://your-frontend.com    # Comma-separated allowed origins

# -----------------------------------------------------------------------------
# Optional: Key Vault Configuration
# -----------------------------------------------------------------------------
# KEYVAULT_MASTER_KEY=                      # Auto-generated if not set
# KEYVAULT_STORAGE_PATH=/secure/path        # Path to encrypted key storage

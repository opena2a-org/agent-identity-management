# Copy this file to .env and adjust ports if any are in use on your host.
# Run: for p in 4317 4318 3200 9090 3100 3001; do lsof -i :$p && echo "BUSY $p"; done
# (the smoke-test.sh script does this for you)

# OTel collector
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_SELF_METRICS_PORT=8888
OTEL_HEALTH_PORT=13133

# Tempo
TEMPO_HTTP_PORT=3200
TEMPO_GRPC_PORT=9095

# Prometheus
PROMETHEUS_PORT=9090

# Loki
LOKI_PORT=3100

# Grafana
GRAFANA_PORT=3001

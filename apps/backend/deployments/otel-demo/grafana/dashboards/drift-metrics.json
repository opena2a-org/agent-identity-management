{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "uid": "aim-drift-metrics",
  "title": "AIM Agent Drift",
  "tags": ["aim", "drift", "trust"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "weekStart": "",
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "agent_id",
        "label": "Agent ID",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": {"qryType": 1, "query": "label_values(agent_drift_score, agent_id)", "refId": "drift-agents"},
        "multi": true,
        "includeAll": true,
        "current": {"text": "All", "value": "$__all"}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "agent.drift_score over time",
      "description": "Drift score is a tanh-saturated function of unauthorized MCP server + capability counts. Bands: 0.3 watch, 0.7 alert, 0.9 critical.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.3},
              {"color": "orange", "value": 0.7},
              {"color": "red", "value": 0.9}
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": {"mode": "dashed"}
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "right"}
      },
      "targets": [
        {
          "expr": "agent_drift_score{agent_id=~\"$agent_id\"}",
          "legendFormat": "{{agent_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Agents currently above 0.7 (alert band)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 12},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "count(agent_drift_score > 0.7)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Agents currently above 0.9 (critical band)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 12},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "count(agent_drift_score > 0.9)",
          "refId": "A"
        }
      ]
    }
  ]
}
